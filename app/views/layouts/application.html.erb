<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>25/10 Crowdsourcing</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "pico", "application", media: "all" %>
  </head>

  <body>
    <header class="container">
      <nav>
        <ul>
          <li><%= link_to "25/10 Crowdsourcing", root_path, class: "brand" %></li>
        </ul>
        <% if session[:administrator_id].present? %>
          <ul>
            <li><%= link_to "My challenges", admin_challenges_path %></li>
          </ul>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <% if notice.present? %>
        <p class="notice" role="status"><%= notice %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="container">
      <%= render "footer" %>
    </footer>
  </body>
</html>
