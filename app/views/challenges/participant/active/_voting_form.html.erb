<div class="vote-buttons" role="group" aria-label="Your score, from 1 (low) to 5 (high)">
  <% (1..5).each do |score| %>
    <%= form_for [challenge, current_vote], html: { id: "vote_form_#{score}" } do |f| %>
      <%= f.hidden_field :vote, value: score, id: nil %>
      <%= f.submit score.to_s,
            class: (current_vote.vote == score ? "selected" : "outline"),
            "aria-pressed": (current_vote.vote == score).to_s %>
    <% end %>
  <% end %>
</div>
<div class="vote-scale" aria-hidden="true">
  <span>&larr; Low</span>
  <span>High &rarr;</span>
</div>
<p>For a score of 5 -- Would you willingly invest your own time/energy/resources in this idea?</p>
